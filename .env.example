# Copy this file to .env. This app only connects to local services.
# FAL_KEY and cloud provider settings are not read or used.

# Ollama desktop/local API
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# ComfyUI local server and API-format workflows.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_VIDEO_WORKFLOW=workflows/video-api.json
COMFYUI_SFX_WORKFLOW=workflows/sfx-api.json

HOST=127.0.0.1
PORT=4173
