# Copy this file to .env and add your fal.ai API key.
# Never put provider keys in app.js, index.html, or any file served to browsers.
FAL_KEY=

# fal.ai model IDs (defaults shown).
FAL_VIDEO_MODEL_ID=fal-ai/veo3
FAL_SFX_MODEL_ID=fal-ai/elevenlabs/sound-effects

# Optional JSON objects for model-specific options. Prompt/text is supplied by the app.
# FAL_VIDEO_INPUT_JSON={"duration":"8s","aspect_ratio":"16:9","resolution":"720p","generate_audio":false}
# FAL_SFX_INPUT_JSON={"duration_seconds":4,"enable_safety_checker":true}

HOST=127.0.0.1
PORT=4173
